/**
 * Test PIO program
 *
 * Pulls a value from the TX FIFO through the OSR, then writes the bits serially to a GPIO pin.
 */
.program test
main_loop:
    pull block          // wait for data in TX FIFO and move into OSR
    set y 31            // use y as a bit counter
bit_write_loop:
    out pins 1              // write one bit to pin from OSR
    jmp y-- bit_write_loop  // decrement y and jump if non-zero (until counter is zero)
    jmp main_loop           // repeat forever